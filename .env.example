# 必填：公开学术 API 要求提供联系邮箱
ZPH_EMAIL=you@example.com

# 可选性能参数
ZPH_WORKERS=16
ZPH_FALLBACK_CLI=auto

# 可选 API 密钥：留空仍可运行，有密钥时覆盖率/限速更好
CORE_API_KEY=
OPENALEXAPIKEY=
SEMANTIC_SCHOLAR_API_KEY=
ENTREZ_EUTILS_API_KEY=
ELSEVIER_TDM_API_KEY=
ELSEVIER_API_KEY=
SPRINGER_API_KEY=

# 机构浏览器登录状态会保存在本机，不应提交到 Git
# BROWSER_FALLBACK_PROFILE=/path/to/private/browser-profile
